@baseUrl = http://localhost:9091

### ==========================================
### 👑 ฝั่ง ADMIN (ผู้ดูแลระบบ)
### ==========================================

# 1. Admin: Login
POST {{baseUrl}}/admin/auth/login
Content-Type: application/json

{
  "email": "x_napaen@hotmail.com",
  "password": "xz123456",
  "rememberMe": false
}

###
# 2. Admin: Register
POST {{baseUrl}}/admin/register
Content-Type: application/json

{
  "firstname": "Admin",
  "lastname": "X",
  "email": "admin2@example.com",
  "password": "Password123!"
}

###
# 3. Admin: Forgot Password
POST {{baseUrl}}/admin/forgot-password
Content-Type: application/json

{
  "email": "x_napaen@hotmail.com"
}

###
# 4. Admin: Profile 
# (ต้องนำ Token ใหม่ที่ได้จาก Admin Login มาใส่แทนค่าด้านล่างเวลาทดสอบจริง)
GET {{baseUrl}}/admin/users/me
Authorization: Bearer YOUR_ADMIN_TOKEN_HERE


### ==========================================
### 👤 ฝั่ง USER (ผู้ใช้งานทั่วไป)
### ==========================================

# 1. User: Login
POST {{baseUrl}}/api/auth/local
Content-Type: application/json

{
  "identifier": "mr.xcoser@gmail.com",
  "password": "0982420293x"
}

###
# 2. User: Register / Signup
POST {{baseUrl}}/api/auth/local/register
Content-Type: application/json

{
  "username": "Mr.xcoser",
  "email": "mr.xcoser@gmail.com",
  "password": "0982420293x"
}

###
# 3. User: Forgot Password
POST {{baseUrl}}/api/auth/forgot-password
Content-Type: application/json

{
  "email": "mr.xcoser@gmail.com"
}

###
