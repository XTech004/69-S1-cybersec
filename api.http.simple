@baseUrl = http://localhost:9091

# Environment Variables from .env
@adminEmail = {{$dotenv ADMIN_EMAIL}}
@adminPassword = {{$dotenv ADMIN_PASSWORD}}
@adminNewPassword = {{$dotenv ADMIN_NEW_PASSWORD}}
@adminRegisterFirstname = {{$dotenv ADMIN_REGISTER_FIRSTNAME}}
@adminRegisterLastname = {{$dotenv ADMIN_REGISTER_LASTNAME}}
@adminRegisterEmail = {{$dotenv ADMIN_REGISTER_EMAIL}}

@userEmail = {{$dotenv USER_EMAIL}}
@userPassword = {{$dotenv USER_PASSWORD}}
@userNewPassword = {{$dotenv USER_NEW_PASSWORD}}
@userRegisterUsername = {{$dotenv USER_REGISTER_USERNAME}}
@userRegisterEmail = {{$dotenv USER_REGISTER_EMAIL}}

### ==========================================
### 👑 1. ฝั่ง ADMIN (ผู้ดูแลระบบ)
### ==========================================

# 1.1 Admin: Login
# @name adminLogin
POST {{baseUrl}}/admin/login
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}",
  "rememberMe": false
}

###
# 1.2 Admin: Signup
// ใช้ได้เฉพาะตอนที่ยังไม่มี Super Admin (ครั้งแรกหลัง setup เท่านั้น)
POST {{baseUrl}}/admin/register-admin
Content-Type: application/json

{
  "firstname": "{{adminRegisterFirstname}}",
  "lastname": "{{adminRegisterLastname}}",
  "email": "{{adminRegisterEmail}}",
  "password": "{{adminPassword}}"
}

###
# 1.3 Admin: Forgot Password
# @name adminForgot
POST {{baseUrl}}/admin/forgot-password
Content-Type: application/json

{
  "email": "{{adminEmail}}"
}

###
# 1.3.1 Admin: Reset Password
// เอา token (query param ชื่อ code) จากลิงก์ในอีเมลที่ 1.3 ส่งกลับไปใส่ใน field resetPasswordToken
POST {{baseUrl}}/admin/reset-password
Content-Type: application/json

{
  "resetPasswordToken": "{{adminForgot.response.body.resetPasswordToken}}",
  "password": "{{adminNewPassword}}"
}

###
# 1.4 Admin: Profile 
// เอา token จาก response ของข้อ 1.1 ไปใส่ใน Authorization
GET {{baseUrl}}/admin/users/me
Authorization: Bearer {{adminLogin.response.body.data.token}}


### ==========================================
### 👤 2. ฝั่ง USER (ผู้ใช้งานทั่วไป)
### ==========================================

# 2.1 User: Login
# @name userLogin
POST {{baseUrl}}/api/auth/local
Content-Type: application/json

{
  "identifier": "{{userEmail}}",
  "password": "{{userPassword}}"
}

###
# 2.2 User: Signup
POST {{baseUrl}}/api/auth/local/register
Content-Type: application/json

{
  "username": "{{userRegisterUsername}}",
  "email": "{{userRegisterEmail}}",
  "password": "{{userPassword}}"
}

###
# 2.3 User: Forgot Password
// Strapi จะคืน 500 ถ้ายังไม่ได้ตั้งค่า SMTP สำหรับส่งอีเมล
# @name userForgot
POST {{baseUrl}}/api/auth/forgot-password
Content-Type: application/json

{
  "email": "{{userEmail}}"
}

###
# 2.3.1 User: Reset Password
// เอา code จากลิงก์ในอีเมลที่ 2.3 ส่งกลับไปใส่ใน field code
POST {{baseUrl}}/api/auth/reset-password
Content-Type: application/json

{
  "code": "{{userForgot.response.body.code}}",
  "password": "{{userNewPassword}}",
  "passwordConfirmation": "{{userNewPassword}}"
}

###
# 2.4 User: Profile
// เอา token จาก response ของข้อ 2.1 ไปใส่ใน Authorization
GET {{baseUrl}}/api/users/me
Authorization: Bearer {{userLogin.response.body.jwt}}


### ==========================================
### 🎓 3. ฝั่ง ข้อมูล (Data Management)
### ==========================================

## 3.1 Student

# 3.1.1 Create
# @name createStudent
// เอา token จาก response ของข้อ 2.1 ไปใส่ใน Authorization
POST {{baseUrl}}/api/students
Authorization: Bearer {{userLogin.response.body.jwt}}
Content-Type: application/json

{
  "data": {
    "name": "Somchai Jaidee",
    "mobile": "0812345678",
    "cardId": "1234567890123"
  }
}

###
# 3.1.2 List All
// เอา token จาก response ของข้อ 2.1 ไปใส่ใน Authorization
GET {{baseUrl}}/api/students
Authorization: Bearer {{userLogin.response.body.jwt}}

###
# 3.1.3 List with ID
// ดึง ID จากข้อ 3.1.1 ให้อัตโนมัติ (หรือเปลี่ยนเป็นเลข ID ที่ต้องการค้นหา)
GET {{baseUrl}}/api/students/{{createStudent.response.body.data.id}}
Authorization: Bearer {{userLogin.response.body.jwt}}

###
# 3.1.4 Update
// ดึง ID จากข้อ 3.1.1 ให้อัตโนมัติ (หรือเปลี่ยนเป็นเลข ID ที่ต้องการอัปเดต)
PUT {{baseUrl}}/api/students/{{createStudent.response.body.data.id}}
Authorization: Bearer {{userLogin.response.body.jwt}}
Content-Type: application/json

{
  "data": {
    "name": "Somchai Jaidee (Updated)"
  }
}

###
# 3.1.5 Delete
// ดึง ID จากข้อ 3.1.1 ให้อัตโนมัติ (หรือเปลี่ยนเป็นเลข ID ที่ต้องการลบ)
DELETE {{baseUrl}}/api/students/{{createStudent.response.body.data.id}}
Authorization: Bearer {{userLogin.response.body.jwt}}


### ==========================================
