@baseUrl = http://localhost:9091

### ==========================================
### 👑 ฝั่ง ADMIN (ผู้ดูแลระบบ)
### ==========================================

# 1. Admin: Login
POST {{baseUrl}}/admin/login
Content-Type: application/json

{
  "email": "admin@example.com",
  "password": "AdminPassword123!",
  "rememberMe": false
}

###
# 2. Admin: Register
POST {{baseUrl}}/admin/register
Content-Type: application/json

{
  "firstname": "Admin",
  "lastname": "X",
  "email": "adminX@example.com",
  "password": "xz123456!"
}

###
# 3. Admin: Forgot Password
POST {{baseUrl}}/admin/forgot-password
Content-Type: application/json

{
  "email": "admin@example.com"
}

###
# 4. Admin: Reset Password
POST {{baseUrl}}/admin/reset-password
Content-Type: application/json

{
  "resetPasswordToken": "RESET_TOKEN_FROM_EMAIL",
  "password": "NewAdminPassword123!"
}

###
# 5. Admin: Profile 
# (ต้องนำ Token ใหม่ที่ได้จาก Admin Login มาใส่แทนค่าด้านล่างเวลาทดสอบจริง)
GET {{baseUrl}}/admin/users/me
Authorization: Bearer YOUR_ADMIN_TOKEN_HERE


### ==========================================
### 👤 ฝั่ง USER (ผู้ใช้งานทั่วไป)
### ==========================================

# 1. User: Login
POST {{baseUrl}}/api/auth/local
Content-Type: application/json

{
  "identifier": "user@example.com",
  "password": "UserPassword123!"
}

###
# 2. User: Register / Signup
POST {{baseUrl}}/api/auth/local/register
Content-Type: application/json

{
  "username": "SampleUser",
  "email": "user@example.com",
  "password": "UserPassword123!"
}

###
# 3. User: Forgot Password
POST {{baseUrl}}/api/auth/forgot-password
Content-Type: application/json

{
  "email": "user@example.com"
}

###
# 4. User: Reset Password
POST {{baseUrl}}/api/auth/reset-password
Content-Type: application/json

{
  "code": "RESET_CODE_FROM_EMAIL",
  "password": "NewUserPassword123!",
  "passwordConfirmation": "NewUserPassword123!"
}

###
# 5. User: Profile
GET {{baseUrl}}/api/users/me
Authorization: Bearer YOUR_USER_TOKEN_HERE